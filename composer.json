{
    "name": "hypejunction/hypeinteractions",
    "version": "5.0.0",
    "type": "elgg-plugin",
    "description": "Enhanced commenting and liking UX for Elgg \u2014 real-time comments, likes, and multi-level threads.",
    "homepage": "https://github.com/hypeJunction/Elgg3-hypeInteractions",
    "keywords": [
        "elgg",
        "plugin",
        "comments",
        "likes",
        "stream",
        "feed",
        "ajax"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypeinteractions",
        "elgg-plugin": {
            "id": "hypeinteractions"
        }
    },
    "require": {
        "composer/installers": "^2.0",
        "php": ">=8.1",
        "elgg/elgg": "^5.0",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
